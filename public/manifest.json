{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "default_locale": "zh_CN",
    "version": "2.0.0",
    "description": "简洁的新标签页，带每日必应壁纸和常用网站。",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "书签设置",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "my-simple-new-tab@yufan.local",
            "strict_min_version": "128.0"
        }
    },
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "permissions": [
        "tabs",
        "storage"
    ]
}
