{
    "manifest_version": 3,
    "name": "My Simple New Tab Extension",
    "version": "2.0.0",
    "description": "简洁的新标签页，带每日必应壁纸和常用网站。",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "host_permissions": [
        "https://*.bing.com/*"
    ],
    "permissions": [
        "tabs",
        "storage"
    ]
}
