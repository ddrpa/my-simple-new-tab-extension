{
    "manifest_version": 3,
    "name": "My Simple New Tab Extension",
    "version": "1.0.0",
    "description": "",
    "background": {
        "service_worker": "background.js"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "host_permissions": [
        "https://*.bing.com/"
    ],
    "permissions": [
        "tabs",
        "storage"
    ]
}
